PORT=3001

SPRING_DATASOURCE_URL=jdbc:postgresql://your-db-host:5432/postgres
SPRING_DATASOURCE_USERNAME=your-db-username
SPRING_DATASOURCE_PASSWORD=your-db-password

API_KEY=your-service-api-key
EVENTS_COMM_KEY=your-events-comm-key
SUPABASE_URL=https://your-project.supabase.co

KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=your-kafka-host:17293
KAFKA_CONSUMER_GROUP_ID=events-service-smoke
KAFKA_SMOKE_CONSUMER_GROUP_ID=events-service-smoke
KAFKA_EVENTS_CONSUMER_GROUP_ID=events-service
KAFKA_TOPIC=mini-crm.kafka.smoke
KAFKA_EVENTS_TOPIC=mini-crm.events
KAFKA_ACCESS_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
KAFKA_ACCESS_CERTIFICATE="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
KAFKA_CA_CERTIFICATE="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
